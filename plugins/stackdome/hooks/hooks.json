{
  "description": "Auto-approve read-only Stackdome CLI commands",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}}/hooks/auto-approve-stackdome.sh"
          }
        ]
      }
    ]
  }
}
